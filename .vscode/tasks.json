{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build do projeto",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\src\\*.cpp",
                "${workspaceFolder}\\vecmath\\src\\*.cpp",
                "-I",
                "${workspaceFolder}\\include",
                "-I",
                "${workspaceFolder}\\vecmath\\include",
                "-o",
                "${workspaceFolder}\\main.exe",
                "-lopengl32",
                "-lfreeglut",
                "-lglu32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "compilador: C:/msys64/mingw64/bin/g++.exe"
        }
    ]
}
